<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WiFi 信息读取（本地设备，不上传） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WiFi 扫描 (Android 13+ 附近设备权限，声明 neverForLocation 免除位置关联) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- GPS 卫星信息（本地设备） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 悬浮窗（本地叠加层） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 电话状态（SIM信息，本地读取） -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 身体活动（API 29+ 步数传感器运行时权限, 未授权时步数计数器/步测器不出现在传感器列表） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- ★ 身体传感器（心率）— 2026-09-01 审查补漏:
         传感器详情页直读 TYPE_HEART_RATE 全链路已有(列表项/详情健康卡/5min 聚合), 但权限从未声明,
         导致该功能在全部版本上静默失效(API 23+ 心率传感器不出现在 getSensorList 或不返回样本)。
         - 不加 maxSdkVersion: android.permission.health.* 是 Health Connect 专用, SensorManager
           直读心率在全部版本(含 API 34+)都需要 BODY_SENSORS, 收窄会让高版本失效
         - 不声明 BODY_SENSORS_BACKGROUND: 仅前台详情页使用, 声明反而触发 Play 后台身体数据政策审查 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- 蓝牙（本地设备） -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 前台服务（悬浮窗保活） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 存储（本地文件） -->
    <!-- ★ #11a: API 33+ 由照片选择器/分区存储接管, READ_EXTERNAL_STORAGE 不再生效, 收窄声明 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 通知（本地通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 震动反馈（线性马达触觉） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DeviceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.DeviceInfoViewer"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="real_time_device_monitoring_overlay" />
        </service>

        <!-- ★ 状态栏快捷磁贴（悬浮窗总开关，API 24+；API 21-23 系统忽略此声明，无副作用。
             exported+BIND_QUICK_SETTINGS_TILE：仅系统可绑定；新装 App 的磁贴默认折叠在
             面板编辑页，需用户手动拖出） -->
        <service
            android:name=".service.FloatWindowTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_float_window"
            android:label="@string/float_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
